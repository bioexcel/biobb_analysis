                    "edam": "format_2033"
                }
            ]
        },
        "output_summary_path": {
            "type": "string",
            "description": "Path to the output summary of the generated clusters",
            "filetype": "output",
            "sample": "https://github.com/bioexcel/biobb_analysis/raw/master/biobb_analysis/test/reference/ambertools/ref_cpptraj.cluster.summary.dat",
            "enum": [
                ".*\\.dat$",
                ".*\\.agr$",
                ".*\\.xmgr$",
                ".*\\.gnu$"
            ],
            "file_formats": [
                {
                    "extension": ".*\\.dat$",
                    "description": "Path to the output summary of the generated clusters",
                    "edam": "format_1637"
                },
                {
                    "extension": ".*\\.agr$",
                    "description": "Path to the output summary of the generated clusters",
                    "edam": "format_2033"
                },
                {
                    "extension": ".*\\.xmgr$",
                    "description": "Path to the output summary of the generated clusters",
                    "edam": "format_2033"
                },
                {
                    "extension": ".*\\.gnu$",
                    "description": "Path to the output summary of the generated clusters",
                    "edam": "format_2033"
                }
            ]
        },
        "output_info_path": {
            "type": "string",
            "description": "Path to the output detailed information of the generated clusters",
            "filetype": "output",
            "sample": "https://github.com/bioexcel/biobb_analysis/raw/master/biobb_analysis/test/reference/ambertools/ref_cpptraj.cluster.info.dat",
            "enum": [
                ".*\\.dat$",
                ".*\\.agr$",
                ".*\\.xmgr$",
                ".*\\.gnu$"
            ],
            "file_formats": [
                {
                    "extension": ".*\\.dat$",
                    "description": "Path to the output detailed information of the generated clusters",
                    "edam": "format_1637"
                },
                {
                    "extension": ".*\\.agr$",
                    "description": "Path to the output detailed information of the generated clusters",
                    "edam": "format_2033"
                },
                {
                    "extension": ".*\\.xmgr$",
                    "description": "Path to the output detailed information of the generated clusters",
                    "edam": "format_2033"
                },
                {
                    "extension": ".*\\.gnu$",
                    "description": "Path to the output detailed information of the generated clusters",
                    "edam": "format_2033"
                }
            ]
        },
        "output_traj_path": {
            "type": "string",
            "description": "Path to the output trajectory containing the representative frame of every cluster",
            "filetype": "output",
            "sample": "https://github.com/bioexcel/biobb_analysis/raw/master/biobb_analysis/test/reference/ambertools/ref_cpptraj.cluster.netcdf",
            "enum": [
                ".*\\.mdcrd$",
                ".*\\.crd$",
                ".*\\.cdf$",
                ".*\\.netcdf$",
                ".*\\.nc$",
                ".*\\.restart$",
                ".*\\.ncrestart$",
                ".*\\.restartnc$",
                ".*\\.dcd$",
                ".*\\.charmm$",
                ".*\\.cor$",
                ".*\\.pdb$",
                ".*\\.mol2$",
                ".*\\.trr$",
                ".*\\.gro$",
                ".*\\.binpos$",
                ".*\\.xtc$",
                ".*\\.cif$",
                ".*\\.arc$",
                ".*\\.sqm$",
                ".*\\.sdf$",
                ".*\\.conflib$"
            ],
            "file_formats": [
                {
                    "extension": ".*\\.mdcrd$",
                    "description": "Path to the output trajectory containing the representative frame of every cluster",
                    "edam": "format_3878"
                },
                {
                    "extension": ".*\\.crd$",
                    "description": "Path to the output trajectory containing the representative frame of every cluster",
                    "edam": "format_3878"
                },
                {
                    "extension": ".*\\.cdf$",
                    "description": "Path to the output trajectory containing the representative frame of every cluster",
                    "edam": "format_3650"
                },
                {
                    "extension": ".*\\.netcdf$",
                    "description": "Path to the output trajectory containing the representative frame of every cluster",
                    "edam": "format_3650"
                },
                {
                    "extension": ".*\\.nc$",
                    "description": "Path to the output trajectory containing the representative frame of every cluster",
                    "edam": "format_3650"
                },
                {
                    "extension": ".*\\.restart$",
                    "description": "Path to the output trajectory containing the representative frame of every cluster",
                    "edam": "format_3886"
                },
                {
                    "extension": ".*\\.ncrestart$",
                    "description": "Path to the output trajectory containing the representative frame of every cluster",
                    "edam": "format_3886"
                },
                {
                    "extension": ".*\\.restartnc$",
                    "description": "Path to the output trajectory containing the representative frame of every cluster",
                    "edam": "format_3886"
                },
                {
