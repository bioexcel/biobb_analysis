                    "edam": "format_3878"
                },
                {
                    "extension": ".*\\.charmm$",
                    "description": "Path to the output trajectory containing the representative frame of every cluster",
                    "edam": "format_3887"
                },
                {
                    "extension": ".*\\.cor$",
                    "description": "Path to the output trajectory containing the representative frame of every cluster",
                    "edam": "format_2033"
                },
                {
                    "extension": ".*\\.pdb$",
                    "description": "Path to the output trajectory containing the representative frame of every cluster",
                    "edam": "format_1476"
                },
                {
                    "extension": ".*\\.mol2$",
                    "description": "Path to the output trajectory containing the representative frame of every cluster",
                    "edam": "format_3816"
                },
                {
                    "extension": ".*\\.trr$",
                    "description": "Path to the output trajectory containing the representative frame of every cluster",
                    "edam": "format_3910"
                },
                {
                    "extension": ".*\\.gro$",
                    "description": "Path to the output trajectory containing the representative frame of every cluster",
                    "edam": "format_2033"
                },
                {
                    "extension": ".*\\.binpos$",
                    "description": "Path to the output trajectory containing the representative frame of every cluster",
                    "edam": "format_3885"
                },
                {
