        "properties": {
            "type": "object",
            "properties": {
                "start": {
                    "type": "integer",
                    "default": 1,
                    "wf_prop": false,
                    "description": "Starting frame for slicing",
                    "min": 1,
                    "max": 100000,
                    "step": 1
                },
                "end": {
                    "type": "integer",
                    "default": -1,
                    "wf_prop": false,
                    "description": "Ending frame for slicing",
                    "min": -1,
                    "max": 100000,
                    "step": 1
                },
                "steps": {
                    "type": "integer",
                    "default": 1,
                    "wf_prop": false,
                    "description": "Step for slicing",
                    "min": 1,
                    "max": 100000,
                    "step": 1
                },
                "mask": {
                    "type": "string",
                    "default": "all-atoms",
                    "wf_prop": false,
                    "description": "Mask definition. ",
                    "enum": [
                        "c-alpha",
                        "backbone",
                        "all-atoms",
                        "heavy-atoms",
                        "side-chain",
                        "solute",
                        "ions",
                        "solvent",
                        "AnyAmberFromatMask"
                    ],
                    "property_formats": [
                        {
                            "name": "c-alpha",
                            "description": "All c-alpha atoms; protein only"
                        },
                        {
                            "name": "backbone",
                            "description": "Backbone atoms"
                        },
                        {
                            "name": "all-atoms",
                            "description": "All system atoms"
                        },
                        {
                            "name": "heavy-atoms",
                            "description": "System heavy atoms; not hydrogen"
                        },
                        {
                            "name": "side-chain",
                            "description": "All not backbone atoms"
                        },
                        {
                            "name": "solute",
                            "description": "All system atoms except solvent atoms"
                        },
                        {
                            "name": "ions",
                            "description": "All ion molecules"
                        },
                        {
                            "name": "solvent",
                            "description": "All solvent atoms"
                        },
                        {
                            "name": "AnyAmberFromatMask",
                            "description": "Amber atom selection syntax like `@*`"
                        }
                    ]
                },
                "algorithm": {
                    "type": "string",
                    "default": "hieragglo",
                    "wf_prop": false,
                    "description": "Clustering algorithm. ",
                    "enum": [
                        "hieragglo",
                        "dbscan",
                        "kmeans",
                        "dpeaks"
                    ],
                    "property_formats": [
                        {
                            "name": "hieragglo",
                            "description": "Hierarchical agglomerative -bottom up- clustering"
                        },
                        {
                            "name": "dbscan",
                            "description": "Density-based spatial clustering of applications with noise"
                        },
                        {
                            "name": "kmeans",
                            "description": "K-means clustering"
                        },
                        {
                            "name": "dpeaks",
                            "description": "Clustering by fast search and find of density peaks; Cpptraj leaves an extra temp.dat file in the working directory"
                        }
                    ]
                },
                "clusters": {
                    "type": "integer",
                    "default": 10,
                    "wf_prop": false,
                    "description": "Target number of clusters. Only used by the hieragglo and kmeans algorithms.",
                    "min": 1,
                    "max": 1000,
                    "step": 1
                },
                "epsilon": {
                    "type": "number",
                    "default": -1.0,
                    "wf_prop": false,
                    "description": "Minimum distance between clusters. Mandatory for the dbscan and dpeaks algorithms; for hieragglo it is an additional stop condition, only used when greater than 0.",
                    "min": -1.0,
                    "max": 100.0,
                    "step": 0.1
                },
                "minpoints": {
                    "type": "integer",
                    "default": 4,
                    "wf_prop": false,
                    "description": "Minimum number of points required to form a cluster. Only used by the dbscan algorithm.",
                    "min": 1,
                    "max": 1000,
                    "step": 1
                },
                "linkage": {
                    "type": "string",
                    "default": "linkage",
                    "wf_prop": false,
                    "description": "Distance between clusters. Only used by the hieragglo algorithm. ",
                    "enum": [
                        "linkage",
                        "averagelinkage",
                        "complete"
                    ],
                    "property_formats": [
                        {
                            "name": "linkage",
                            "description": "Shortest distance between members of the two clusters"
                        },
                        {
                            "name": "averagelinkage",
                            "description": "Average distance between members of the two clusters"
                        },
                        {
                            "name": "complete",
                            "description": "Longest distance between members of the two clusters"
                        }
                    ]
                },
                "metric": {
                    "type": "string",
                    "default": "rms",
                    "wf_prop": false,
                    "description": "Distance metric between frames. ",
                    "enum": [
                        "rms",
                        "srmsd",
                        "dme",
                        "qrmsd"
                    ],
                    "property_formats": [
                        {
                            "name": "rms",
                            "description": "Coordinate root mean square deviation"
                        },
                        {
                            "name": "srmsd",
                            "description": "Symmetry-corrected coordinate root mean square deviation"
                        },
                        {
                            "name": "dme",
                            "description": "Distance root mean square deviation"
                        },
                        {
                            "name": "qrmsd",
                            "description": "Quaternion root mean square deviation"
                        }
                    ]
                },
                "mass": {
                    "type": "boolean",
                    "default": false,
                    "wf_prop": false,
                    "description": "Mass-weight the distance metric."
                },
                "nofit": {
                    "type": "boolean",
                    "default": false,
                    "wf_prop": false,
                    "description": "Do not best-fit the frames before calculating the distance metric."
                },
                "sieve": {
                    "type": "integer",
                    "default": 0,
                    "wf_prop": false,
                    "description": "Cluster only every nth frame and add the remaining frames back in afterwards. 0 disables sieving.",
                    "min": 0,
                    "max": 100000,
                    "step": 1
                },
                "binary_path": {
                    "type": "string",
                    "default": "cpptraj",
                    "wf_prop": false,
                    "description": "Path to the cpptraj executable binary."
                },
                "remove_tmp": {
                    "type": "boolean",
                    "default": true,
                    "wf_prop": true,
                    "description": "Remove temporal files."
                },
                "restart": {
                    "type": "boolean",
                    "default": false,
                    "wf_prop": true,
                    "description": "Do not execute if output files exist."
                },
                "sandbox_path": {
                    "type": "string",
                    "default": "./",
                    "wf_prop": true,
                    "description": "Parent path to the sandbox directory."
                },
                "container_path": {
                    "type": "string",
                    "default": null,
                    "wf_prop": false,
                    "description": "Container path definition."
                },
                "container_image": {
                    "type": "string",
                    "default": "afandiadib/ambertools:serial",
                    "wf_prop": false,
                    "description": "Container image definition."
                },
                "container_volume_path": {
                    "type": "string",
                    "default": "/tmp",
                    "wf_prop": false,
                    "description": "Container volume path definition."
                },
                "container_working_dir": {
                    "type": "string",
                    "default": null,
                    "wf_prop": false,
                    "description": "Container working directory definition."
                },
                "container_user_id": {
                    "type": "string",
                    "default": null,
                    "wf_prop": false,
                    "description": "Container user_id definition."
                },
                "container_shell_path": {
                    "type": "string",
                    "default": "/bin/bash",
                    "wf_prop": false,
                    "description": "Path to default shell inside the container."
                }
            }
        }
    },
    "additionalProperties": false
}